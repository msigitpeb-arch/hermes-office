# Salin ke .env lalu isi:  cp .env.example .env && nano .env

# --- LLM via 9router (VPS) ---
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=sk-isi-key-9router
LLM_MODEL=scraping-news
LLM_TIMEOUT=180

# --- WhatsApp via Fonnte (kosongkan kalau tidak dipakai) ---
FONNTE_TOKEN=
# Personal, grup (xxx@g.us), atau gabungan dipisah koma tanpa spasi
WA_TARGET_NUMBER=

# --- Telegram (opsional, kosongkan kalau tidak dipakai) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kirim ke topik tertentu di grup forum. Dari link pesan t.me/c/1234567890/5/10:
# TELEGRAM_CHAT_ID=-1001234567890 dan TELEGRAM_THREAD_ID=5
TELEGRAM_THREAD_ID=

# --- Gaya & perilaku ---
# Disebut di salam: "Selamat sore, Rekan-rekan. ..."
AUDIENCE="Rekan-rekan"
# split = 1 pesan per berita (preview link muncul di tiap pesan)
# digest = semua berita dalam 1 pesan
SEND_MODE=split
# Berita lebih tua dari ini diabaikan
MAX_AGE_HOURS=36
# Lama URL disimpan di riwayat anti-duplikat
HISTORY_DAYS=10
